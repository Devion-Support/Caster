# Caster Android Library - Optimized .gitignore
# ====================================

# Built application files
*.apk
*.aar
*.aab
*.ap_
*.a_

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
.externalNativeBuild/
.cxx/
*.so
*.so.*

# Local configuration file
local.properties

# Environment variables
.env

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
output.json
output-metadata.json

# Keystore files
*.jks
*.keystore

# Build artifacts
mapping.txt
seeds.txt
unused.txt
*.hprof

# Native build artifacts
*.o
*.d

# Log Files
*.log
hs_err_pid*
replay_pid*

# GitHub cache files
.github/cache/
.github/actions/cache/

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ProGuard / R8
proguard/

# Android Profiling
*.trace

# Compilation database for Clang
compile_commands.json

# Library-specific files to exclude
lib/mapping.txt
lib/seeds.txt
lib/unused.txt

# Library publication artifacts
lib/outputs/

# Test reports
*/test-results
*/reports/
*/build/reports/

# Code coverage
*/jacoco/
*/coverage/
*/kover/

# Detekt
*/detekt/

# Avoid ignoring Gradle wrapper files
!gradle-wrapper.jar
!gradle-wrapper.properties

# VS Code
.vscode/

# Flutter/Dart/Pub related (if used)
**/doc/api/
**/ios/Flutter/.last_build_id

# App-specific secrets
app/secrets.xml
app/secrets.properties

# Firebase config
google-services.json
firebase_options.dart