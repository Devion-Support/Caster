package io.github.yoganataa.caster.core

import androidx.test.ext.junit.runners.AndroidJUnit4
import androidx.test.platform.app.InstrumentationRegistry
import io.github.yoganataa.caster.core.detection.app.MaliciousAppDetector
import io.github.yoganataa.caster.core.detection.environment.EmulatorDetector
import io.github.yoganataa.caster.core.detection.root.RootDetector
import io.github.yoganataa.caster.core.detection.tampering.AntiTamperingDetector
import kotlinx.coroutines.runBlocking
import org.junit.Assert.*
import org.junit.Before
import org.junit.Test
import org.junit.runner.RunWith

/**
 * Instrumentation test class for individual Caster detectors.
 * These tests run on a real Android device or emulator.
 */
@RunWith(AndroidJUnit4::class)
class DetectorInstrumentedTest {

    private lateinit var context: android.content.Context

    /**
     * Sets up the test environment before each test.
     * Initializes the application context and attempts to load the native 'toolChecker' library.
     */
    @Before
    fun setup() {
        context = InstrumentationRegistry.getInstrumentation().targetContext
        // Important: Ensure the native 'toolChecker' library is loaded.
        // Tests relying on it will fail if the native library is not found in the test environment.
        try {
            System.loadLibrary("toolChecker")
        } catch (e: UnsatisfiedLinkError) {
            // Ignore error if the library is not present, but tests depending on it will be skipped or fail.
            println("Warning: Failed to load 'toolChecker' library. Native tests might be skipped.")
        }
    }

    /**
     * Tests if the [EmulatorDetector] correctly identifies an emulator environment.
     * This test assumes it's run on a standard Android Studio emulator.
     */
    @Test
    fun emulatorDetector_detectsEmulator() = runBlocking {
        val detector = EmulatorDetector(context)
        val result = detector.detect()

        // Assertions based on running in a standard Android Studio emulator
        assertTrue("Should detect as an emulator", result.isEmulator)
        assertTrue("Should find detected methods", result.detectedMethods.isNotEmpty())
        assertTrue("Confidence should be greater than 0", result.confidence > 0f)
        // The severity might vary based on emulator type and detection methods, so checking for non-null is safer.
        assertNotNull("Threat severity should not be null", result.threats.firstOrNull()?.severity)
    }

    /**
     * Tests if the [RootDetector] does not detect root on a standard, non-rooted emulator.
     * This test assumes it's run on a standard Android Studio emulator that is NOT rooted.
     */
    @Test
    fun rootDetector_doesNotDetectRootOnStandardEmulator() = runBlocking {
        val detector = RootDetector(context)
        val result = detector.detect()

        // Assertions based on running in a standard, non-rooted emulator
        assertFalse("Should not detect root on a standard emulator", result.isRooted)
        assertEquals("Confidence should be 0 on a non-rooted device", 0f, result.confidence)
        assertTrue("Should find no root threats", result.threats.isEmpty())
    }

    /**
     * Tests if the [MaliciousAppDetector] correctly detects a custom application.
     * The test uses the current application's package name as a custom malicious app.
     */
    @Test
    fun maliciousAppDetector_detectsCustomApp() = runBlocking {
        val config = CasterConfig(enableIntegrityChecks = false, enableAntiTampering = false) // Provide a basic config for testing
        val detector = MaliciousAppDetector(context, config)

        // Use the current test application's package name as a custom malicious app
        val testPackageName = context.packageName
        detector.addCustomMaliciousApps(listOf(testPackageName))

        val result = detector.detectMaliciousApps()

        // 1. Verify that the detector reports malicious apps
        assertTrue("Should detect malicious applications", result.hasMaliciousApps)

        // 2. Verify that our specific test package is detected in the results.
        val isOurTestPackageDetected = result.detectedApps.any { it.packageName == testPackageName }
        assertTrue("The custom test application ($testPackageName) should be detected in the results.", isOurTestPackageDetected)

        // 3. (Optional) Verify the specific category of our detected app
        val ourDetectedApp = result.detectedApps.find { it.packageName == testPackageName }
        assertNotNull("Our test app object should not be null", ourDetectedApp)
        assertEquals("Suspicious App (Custom List)", ourDetectedApp?.category)
    }

    /**
     * Tests if the [AntiTamperingDetector] correctly reports no debugger attached.
     * This test is only valid when run normally (not in debug mode).
     */
    @Test
    fun antiTamperingDetector_detectsNoDebugger() {
        // This test is only valid if run normally (not in debug mode)
        if (android.os.Debug.isDebuggerConnected()) {
            println("Skipping anti-tampering test: Debugger is connected.")
            return
        }
        val detector = AntiTamperingDetector()
        val result = detector.detect()

        assertFalse("Should not have a debugger attached during normal run", result.isDebuggerAttached)
    }
}